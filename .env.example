# Host ports for your reverse proxy (published on the Docker host)
BRIDGE_PORT=3000
ELEMENT_PORT=8080

# Public https URLs (what SPH + browsers see). No trailing slash.
PUBLIC_BASE_URL=https://sph-auth.svc.example.de
ELEMENT_WEB_URL=https://chat.svc.example.de

# MXID domain (@user:…)
MATRIX_SERVER_NAME=example.de

# SPH tile "Definiertes Secret" (letters+digits, max 120)
SPH_SECRET=change-me-to-a-long-random-secret

# Shared with tuwunel [global.jwt].key (written by config-init)
JWT_SECRET=change-me-to-another-long-random-secret

FOLDER_NAME=matrix
ALLOW_ALL_IPS=false

CONNECT_TTL_SECONDS=120
JWT_TTL_SECONDS=3600

BRIDGE_IMAGE=ghcr.io/alessioc42/sph_tuwunel:latest
BRIDGE_CONTAINER_NAME=sph-bridge
CINNY_CONTAINER_NAME=sph-cinny
TUWUNEL_CONTAINER_NAME=sph-tuwunel-hs
CINNY_IMAGE=ajbura/cinny:v4.12.6
TUWUNEL_IMAGE=ghcr.io/matrix-construct/tuwunel:latest

# --- local bun-only (optional) ---
PORT=3000
DATA_DIR=./data
ENABLE_MATRIX_PROXY=true
CORS_ORIGINS=https://chat.svc.example.de
MATRIX_HOMESERVER=http://127.0.0.1:8008
